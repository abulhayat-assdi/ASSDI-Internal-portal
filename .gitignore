# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# firebase
firebase-debug.log
.firebaserc
.firebase/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase credentials (NEVER commit this!)
serviceAccountKey.json
/generated/prisma

# Runtime-written uploads and logs — never commit user data
/public/homework/
/public/documents/
/public/uploads/
/storage/
*.log
build-log.txt
lint_output.txt
tsconfig.tsbuildinfo

# Local backup artifacts
/backups/

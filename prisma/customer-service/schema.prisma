generator client {
  provider = "prisma-client-js"
  output   = "../../generated/customer-service"
}

// Live chat training: all operational data lives in the CRM database.
model ChatSettings {
  id String @id @default(uuid())
  courseId String
  workspaceId String @unique
  value Json @default("{}")
  version Int @default(1)
  @@unique([workspaceId, id])
}

model ChatCategory {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  name String
  active Boolean @default(true)
  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
}

model ChatTrainingSession {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  name String
  mode String @default("PRACTICE")
  state String @default("OPEN")
  scenario String @default("")
  participants String[]
  startsAt DateTime @default(now())
  endsAt DateTime?
  hints Boolean @default(true)
  demonstrationId String?
  rubric Json
  policySnapshot Json @default("{}")
  passMark Int @default(70)
  released Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
  @@index([workspaceId, state])
}

model ChatPublicLink {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  tokenHash String @unique
  sessionId String?
  active Boolean @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
}

model ChatAgentState {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  userId String
  name String
  roll String @default("")
  status String @default("OFFLINE")
  heartbeatAt DateTime @default(now())
  statusAt DateTime @default(now())
  lastAssignedAt DateTime @default(now())
  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([workspaceId, status, lastAssignedAt])
}

model ChatCustomerSession {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  tokenHash String @unique
  name String
  heartbeatAt DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
}

model ChatConversation {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  sessionId String?
  customerSessionId String
  customerName String
  categoryId String
  status String @default("QUEUED")
  agentId String?
  customerId String?
  complaintId String?
  createdAt DateTime @default(now())
  queueAt DateTime @default(now())
  assignedAt DateTime?
  acceptedAt DateTime?
  firstReplyAt DateTime?
  resolvedAt DateTime?
  closedAt DateTime?
  lastCustomerAt DateTime @default(now())
  lastAgentAt DateTime?
  unansweredAt DateTime?
  lastActivityAt DateTime @default(now())
  warned Boolean @default(false)
  serviceSeconds Int @default(60)
  policySnapshot Json @default("{}")
  resolution String @default("")
  closingNote String @default("")
  transferTo String?
  transferAt DateTime?
  customerTypingAt DateTime?
  agentTypingAt DateTime?
  customerReadAt DateTime?
  agentReadAt DateTime?
  feedback Int?
  feedbackComment String @default("")
  @@unique([workspaceId, id])
  @@index([workspaceId, status, queueAt])
  @@index([workspaceId, agentId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, customerSessionId])
}

model ChatMessage {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  courseId String
  workspaceId String
  conversationId String
  senderId String
  senderName String
  sender String
  kind String @default("MESSAGE")
  text String
  requestId String
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
  @@unique([workspaceId, conversationId, senderId, requestId])
  @@index([workspaceId, conversationId, createdAt, id])
  @@index([workspaceId, conversationId, sequence], map: "ChatMessage_workspace_conversation_sequence_idx")
}

model ChatAssignment {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  conversationId String
  agentId String
  startedAt DateTime @default(now())
  acceptedAt DateTime?
  firstReplyAt DateTime?
  endedAt DateTime?
  wrapSeconds Int @default(0)
  handleSeconds Float @default(0)
  @@unique([workspaceId, id])
  @@index([workspaceId, conversationId])
  @@index([workspaceId, agentId, endedAt])
}

model ChatEvent {
  id BigInt @id @default(autoincrement())
  courseId String
  workspaceId String
  conversationId String?
  actorId String
  type String
  data Json @default("{}")
  createdAt DateTime @default(now())
  @@index([workspaceId, id])
  @@index([workspaceId, conversationId, id])
}

model ChatQaEvaluation {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  conversationId String
  agentId String
  evaluatorId String
  scores Json
  rubric Json
  total Float
  passMark Int
  feedback String
  privateNote String @default("")
  released Boolean @default(false)
  createdAt DateTime @default(now())
  @@unique([workspaceId, id])
  @@unique([workspaceId, conversationId, agentId])
}

model ChatReference {
  id String @id @default(uuid())
  courseId String
  workspaceId String
  kind String
  title String
  text String
  active Boolean @default(true)
  @@unique([workspaceId, id])
  @@index([workspaceId, kind])
}

model ChatRateBucket {
  id String @id
  courseId String
  workspaceId String
  count Int @default(1)
  expiresAt DateTime
  @@index([workspaceId, expiresAt])
}

datasource db {
  provider = "postgresql"
  url      = env("CUSTOMER_SERVICE_DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid())
  courseId  String
  batchId   String
  name      String
  state     String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@unique([courseId, batchId])
  @@unique([courseId, id])
}

model Member {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  userId      String
  role        String   @default("AGENT")
  teamId      String?
  active      Boolean  @default(true)

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([courseId, workspaceId])
}

model StaffAssignment {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  userId      String

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId])
  @@index([courseId, workspaceId])
}

model Team {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  name        String
  tier        String
  active      Boolean  @default(true)

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([courseId, workspaceId])
}

model Customer {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  name        String
  number      String
  dummy       Boolean  @default(true)
  trainingKey String?
  registeredNumber String @default("")
  registeredNormalized String @default("")
  trainingProfile Json?

  @@unique([workspaceId, id])
  @@unique([workspaceId, number])
  @@unique([workspaceId, trainingKey])
  @@index([workspaceId, registeredNormalized])
  @@index([courseId, workspaceId])
}

model Option {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  kind        String
  label       String
  parentId    String?
  active      Boolean  @default(true)
  settings    Json     @default("{}")
  version     Int      @default(1)

  @@unique([workspaceId, id])
  @@unique([workspaceId, kind, label])
  @@index([courseId, workspaceId])
}

model Policy {
  id             String   @id @default(uuid())
  courseId       String
  workspaceId    String
  createdAt      DateTime @default(now())
  key            String
  version        Int      @default(1)
  complaintType  String   @default("")
  issueType      String   @default("")
  primaryTag     String   @default("")
  overallMinutes Int
  l2Minutes      Int?
  l3Minutes      Int?
  active         Boolean  @default(true)

  @@unique([workspaceId, id])
  @@unique([workspaceId, key])
  @@index([courseId, workspaceId])
}

model Complaint {
  id                   String    @id @default(uuid())
  courseId             String
  workspaceId          String
  createdAt            DateTime  @default(now())
  code                 String    @unique
  requestId            String
  customerId           String?
  creatorId            String
  ownerId              String?
  teamId               String?
  callingNumber        String
  callingNormalized    String
  registeredNumber     String    @default("")
  registeredNormalized String    @default("")
  identifier           String    @default("")
  callerType           String
  channel              String
  complaintType        String
  issueType            String
  primaryTag           String    @default("")
  tags                 String[]
  transactionDate      DateTime?
  transactionAmount    Decimal?  @db.Decimal(18, 2)
  transactionId        String    @default("")
  description          String
  customFields         Json      @default("{}")
  fieldSnapshot        Json      @default("[]")
  status               String    @default("PENDING")
  queue                String    @default("AGENT")
  returnState          String    @default("NORMAL")
  resolutionReason     String    @default("")
  remarks              String    @default("")
  resolverId           String?
  resolvedAt           DateTime?
  closedAt             DateTime?
  firstL2At            DateTime?
  l2CompletedAt        DateTime?
  firstL3At            DateTime?
  l2DueAt              DateTime?
  l3DueAt              DateTime?
  dueAt                DateTime
  policySnapshot       Json
  version              Int       @default(1)
  updatedAt            DateTime  @updatedAt

  @@unique([workspaceId, id])
  @@unique([workspaceId, creatorId, requestId])
  @@index([courseId, workspaceId])
  @@index([workspaceId, status, queue])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, callingNormalized, createdAt])
  @@index([workspaceId, registeredNormalized])
  @@index([workspaceId, resolvedAt])
  @@index([workspaceId, dueAt])
}

model History {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  complaintId String
  actorId     String
  actorName   String
  actorRole   String
  action      String
  before      Json
  after       Json
  remark      String   @default("")
  requestId   String

  @@unique([workspaceId, id])
  @@unique([workspaceId, complaintId, requestId])
  @@index([courseId, workspaceId])
  @@index([workspaceId, complaintId, createdAt])
}

model Interaction {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  complaintId String
  actorId     String
  channel     String
  note        String

  @@unique([workspaceId, id])
  @@index([courseId, workspaceId])
  @@index([workspaceId, createdAt])
}

model Note {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  complaintId String
  actorId     String
  text        String

  @@unique([workspaceId, id])
  @@index([courseId, workspaceId])
}

model FollowUp {
  id            String    @id @default(uuid())
  courseId      String
  workspaceId   String
  createdAt     DateTime  @default(now())
  complaintId   String
  responsibleId String
  dueAt         DateTime
  note          String
  completedAt   DateTime?

  @@unique([workspaceId, id])
  @@index([courseId, workspaceId])
  @@index([workspaceId, responsibleId, dueAt])
}

model Escalation {
  id            String    @id @default(uuid())
  courseId      String
  workspaceId   String
  createdAt     DateTime  @default(now())
  complaintId   String
  stage         String
  startedAt     DateTime
  completedAt   DateTime?
  targetMinutes Int?

  @@unique([workspaceId, id])
  @@unique([workspaceId, complaintId, stage])
  @@index([courseId, workspaceId])
}

model Audit {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  actorId     String
  actorName   String
  action      String
  data        Json

  @@unique([workspaceId, id])
  @@index([courseId, workspaceId])
}

model Notification {
  id          String   @id @default(uuid())
  courseId    String
  workspaceId String
  createdAt   DateTime @default(now())
  userId      String
  complaintId String
  eventKey    String
  message     String
  readAt      DateTime?

  @@unique([workspaceId, id])
  @@unique([workspaceId, userId, eventKey])
  @@index([courseId, workspaceId])
  @@index([workspaceId, userId, createdAt])
}

// ============================================================
// COMPETITIONS (Battle of Cups, etc.)
// ============================================================

model CompetitionFormTemplate {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  name      String // e.g., "Default Form 1"
  schema    Json // Array of predefined questions
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("competition_form_templates")
}

model Competition {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  title       String // e.g., "Battle of Cups"
  description String?
  batchName   String    @map("batch_name")
  schema      Json // Form schema (questions, types, validations)
  isActive    Boolean   @default(true) @map("is_active")
  startDate   DateTime  @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  course       Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions  CompetitionSubmission[]
  corrections  CompetitionCorrectionRequest[]
  products     CompetitionProduct[]
  procurements CompetitionProcurement[]

  @@index([batchName])
  @@index([courseId])
  @@map("competitions")
}

// A product teams can take from staff during a competition, with its price per piece.
model CompetitionProduct {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  competitionId String   @map("competition_id")
  name          String
  unitPrice     Float    @default(0) @map("unit_price")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course       Course                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competition  Competition              @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  procurements CompetitionProcurement[]

  @@index([competitionId])
  @@index([courseId])
  @@map("competition_products")
}

// One handover of a product to a team member. What is still due is always
// totalAmount - paidAmount; it is never stored.
model CompetitionProcurement {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  competitionId String   @map("competition_id")
  productId     String   @map("product_id")
  groupId       String   @map("group_id")
  groupName     String   @map("group_name") // as it was when recorded; lists show the team's current name
  memberRoll    String   @map("member_roll")
  memberName    String   @map("member_name")
  quantity      Int
  unitPrice     Float    @map("unit_price") // the product's price at the time
  totalAmount   Float    @map("total_amount")
  paidAmount    Float    @default(0) @map("paid_amount")
  procuredOn    String   @map("procured_on") // YYYY-MM-DD
  note          String?
  recordedBy    String   @map("recorded_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competition Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  product     CompetitionProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([competitionId])
  @@index([courseId])
  @@index([productId])
  @@map("competition_procurements")
}

model CompetitionSubmission {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  competitionId String   @map("competition_id")
  type          String // "team" or "individual"
  teamName      String?  @map("team_name")
  rollNumber    String   @map("roll_number")
  studentName   String   @map("student_name")
  data          Json // The answers provided (e.g., cups sold, profit, etc.)
  // Set by the student-portal form. Legacy/bulk rows leave both null and fall
  // back to teamName matching and the submittedAt day (see lib/competitions).
  groupId       String?  @map("group_id")
  reportDate    String?  @map("report_date") // YYYY-MM-DD the report is for
  submittedAt   DateTime @default(now()) @map("submitted_at")

  course      Course                         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competition Competition                    @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  corrections CompetitionCorrectionRequest[]

  @@index([competitionId])
  @@index([type])
  @@index([courseId])
  @@map("competition_submissions")
}

// A student asks for an already-submitted day to be changed; the submission is
// only rewritten once staff approve.
model CompetitionCorrectionRequest {
  id            String    @id @default(uuid())
  courseId      String    @map("course_id")
  competitionId String    @map("competition_id")
  submissionId  String    @map("submission_id")
  requesterRoll String    @map("requester_roll")
  requesterName String    @map("requester_name")
  reason        String    @default("")
  newData       Json      @map("new_data")
  oldData       Json?     @map("old_data") // snapshot taken at approval
  status        String    @default("pending") // pending | approved | rejected
  reviewNote    String?   @map("review_note")
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competition Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  submission  CompetitionSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([competitionId])
  @@index([submissionId])
  @@map("competition_correction_requests")
}

model CompetitionGroup {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  competitionId String?  @map("competition_id")
  batchName     String   @map("batch_name")
  groupName     String   @map("group_name")
  members       Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([batchName])
  @@index([competitionId])
  @@index([courseId])
  @@map("competition_groups")
}

// ============================================================
// TYPING TEST EXAM (assessment — separate from the Typing Adventure game)
// ============================================================

model TypingExam {
  id          String               @id @default(uuid())
  courseId    String               @map("course_id")
  title       String
  description String               @default("")
  accessType  TypingExamAccessType @default(INTERNAL) @map("access_type")

  // INTERNAL access
  batchNames Json @default("[]") @map("batch_names") // string[] of Batch.name

  durationSeconds Int @default(60) @map("duration_seconds")

  passWpm      Float @map("pass_wpm")
  passAccuracy Float @map("pass_accuracy")
  failWpm      Float @map("fail_wpm")
  failAccuracy Float @map("fail_accuracy")

  textSource   TypingExamTextSource @default(CUSTOM) @map("text_source")
  textLanguage String               @default("en") @map("text_language")
  // BANK category the passage was picked from (null = random across all / CUSTOM text).
  textCategory String?              @map("text_category")
  examText     String               @default("") @map("exam_text") // resolved passage, fixed at creation for fair comparison

  isActive      Boolean   @default(true) @map("is_active")
  scheduleStart DateTime? @map("schedule_start")
  scheduleEnd   DateTime? @map("schedule_end")

  // PUBLIC access
  publicSlug String? @unique @map("public_slug")

  // Retry gate — one fixed password per exam (both INTERNAL and PUBLIC).
  // First attempt by any taker never needs it; every attempt after the
  // first must supply the plaintext password, verified via bcrypt against
  // this hash. Required at the API layer on create; nullable at the DB
  // level on purpose so a schema migration never needs to backfill a hash
  // nobody knows the plaintext of.
  retryPasswordHash String? @map("retry_password_hash")

  createdByUid  String @map("created_by_uid")
  createdByName String @default("") @map("created_by_name")
  createdByRole String @default("") @map("created_by_role") // 'admin' | 'teacher'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts TypingExamAttempt[]
  sessions TypingExamSession[]

  @@index([courseId])
  @@index([accessType])
  @@index([isActive])
  @@index([publicSlug])
  @@map("typing_exams")
}

model TypingExamAttempt {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  examId   String @map("exam_id")

  takerType TypingExamTakerType @map("taker_type")

  // STUDENT taker
  studentUserId    String? @map("student_user_id")
  studentName      String  @default("") @map("student_name")
  studentRoll      String  @default("") @map("student_roll")
  studentBatchName String  @default("") @map("student_batch_name")

  // PUBLIC taker
  publicName  String @default("") @map("public_name")
  publicRoll  String @default("") @map("public_roll")
  publicPhone String @default("") @map("public_phone")

  attemptNumber        Int              @default(1) @map("attempt_number")
  wpm                  Float
  accuracy             Float
  correctChars         Int              @default(0) @map("correct_chars")
  totalChars           Int              @default(0) @map("total_chars")
  durationTakenSeconds Int              @default(0) @map("duration_taken_seconds")
  result               TypingExamResult

  // Engine v2 audit trail (src/lib/typing-exam/engine.ts). Rows recorded
  // before it have engineVersion 1, an empty typedText and no finishReason.
  engineVersion     Int                     @default(1) @map("engine_version")
  rawWpm            Float                   @default(0) @map("raw_wpm")
  keystrokesTotal   Int                     @default(0) @map("keystrokes_total")
  keystrokesCorrect Int                     @default(0) @map("keystrokes_correct")
  typedText         String                  @default("") @map("typed_text")
  finishReason      TypingExamFinishReason? @map("finish_reason")
  sessionId         String?                 @unique @map("session_id")

  startedAt   DateTime @default(now()) @map("started_at")
  submittedAt DateTime @default(now()) @map("submitted_at")

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam   TypingExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([studentUserId])
  @@index([publicPhone])
  @@index([courseId])
  @@map("typing_exam_attempts")
}

// One in-flight run of a typing exam. Created when the taker starts, kept
// up to date by autosave, and turned into exactly one TypingExamAttempt —
// by the taker's own submit, or (if they closed the tab / lost the network)
// by finalizeStaleSessions from the last autosaved progress. This is what
// guarantees a taker who typed something never ends up with a blank result.
model TypingExamSession {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  examId   String @map("exam_id")

  takerType        TypingExamTakerType @map("taker_type")
  studentUserId    String?             @map("student_user_id")
  studentName      String              @default("") @map("student_name")
  studentRoll      String              @default("") @map("student_roll")
  studentBatchName String              @default("") @map("student_batch_name")
  publicName       String              @default("") @map("public_name")
  publicRoll       String              @default("") @map("public_roll")
  publicPhone      String              @default("") @map("public_phone")

  // sha256 of the bearer token handed to a PUBLIC taker at start (they have
  // no login session). Empty for STUDENT sessions, which use the auth cookie.
  tokenHash     String                  @default("") @map("token_hash")
  attemptNumber Int                     @default(1) @map("attempt_number")
  status        TypingExamSessionStatus @default(OPEN)

  // Last autosaved progress (all elapsed values already clamped to server time).
  typedText         String                  @default("") @map("typed_text")
  keystrokesTotal   Int                     @default(0) @map("keystrokes_total")
  keystrokesCorrect Int                     @default(0) @map("keystrokes_correct")
  elapsedMs         Int                     @default(0) @map("elapsed_ms")
  finishReason      TypingExamFinishReason? @map("finish_reason")

  attemptId String? @unique @map("attempt_id")

  createdAt      DateTime  @default(now()) @map("created_at")
  lastProgressAt DateTime? @map("last_progress_at")
  finalizedAt    DateTime? @map("finalized_at")

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam   TypingExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, status])
  @@index([studentUserId])
  @@index([publicPhone])
  @@index([courseId])
  @@map("typing_exam_sessions")
}

// ============================================================
// QUIZ / MCQ ENGINE (self-paced v1 — see TypingExam above for the
// same course-scoping + batch-targeting + schedule-window pattern)
// ============================================================

model Quiz {
  id              String @id @default(uuid())
  courseId        String @map("course_id")
  title           String
  descriptionHtml String @default("") @map("description_html")

  // Targeting — same convention as TypingExam.batchNames: string[] of Batch.name, "all" = every batch.
  batchNames Json @default("[]") @map("batch_names")

  optionLabelStyle QuizOptionLabelStyle @default(LETTERS) @map("option_label_style")
  shuffleQuestions Boolean              @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean              @default(true) @map("shuffle_options")
  allowBacktrack   Boolean              @default(true) @map("allow_backtrack")

  durationSeconds     Int?    @map("duration_seconds") // whole-quiz timer; null = untimed
  maxAttempts         Int     @default(1) @map("max_attempts")
  practiceModeAllowed Boolean @default(false) @map("practice_mode_allowed")

  negativeMarkPerWrong Float  @default(0) @map("negative_mark_per_wrong")
  passPercentage       Float? @map("pass_percentage")

  // Leaderboard shown to students of the quiz's batches once results are visible.
  showLeaderboard      Boolean @default(true) @map("show_leaderboard")
  leaderboardShowNames Boolean @default(true) @map("leaderboard_show_names")

  resultReleaseMode QuizResultReleaseMode @default(IMMEDIATE) @map("result_release_mode")
  resultReleaseAt   DateTime?             @map("result_release_at") // scheduled auto-release
  resultsReleasedAt DateTime?             @map("results_released_at") // set when a teacher manually releases early

  isActive      Boolean   @default(true) @map("is_active")
  scheduleStart DateTime? @map("schedule_start")
  scheduleEnd   DateTime? @map("schedule_end")

  createdByUid  String @map("created_by_uid")
  createdByName String @default("") @map("created_by_name")
  createdByRole String @default("") @map("created_by_role") // 'admin' | 'teacher'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]
  attempts     QuizAttempt[]
  liveSessions QuizLiveSession[]

  @@index([courseId])
  @@index([isActive])
  @@map("quizzes")
}

model QuizQuestion {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  quizId   String @map("quiz_id")

  order            Int              @default(0)
  type             QuizQuestionType @default(SINGLE_CHOICE)
  bodyHtml         String           @default("") @map("body_html")
  marks            Float            @default(1)
  explanationHtml  String           @default("") @map("explanation_html")
  tag              String?
  difficulty       String?
  timeLimitSeconds Int?             @map("time_limit_seconds") // live mode per-question timer; null = session default

  // [{ id, textHtml, isCorrect }] — empty for SHORT_ANSWER.
  options Json @default("[]")

  // Traceability only (copied at creation, not a live link) — mirrors
  // TypingExam.examText's "resolved passage, fixed at creation" principle.
  sourceBankItemId String? @map("source_bank_item_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([courseId])
  @@map("quiz_questions")
}

model QuizQuestionBankItem {
  id       String @id @default(uuid())
  courseId String @map("course_id")

  type            QuizQuestionType @default(SINGLE_CHOICE)
  bodyHtml        String           @default("") @map("body_html")
  marks           Float            @default(1)
  explanationHtml String           @default("") @map("explanation_html")
  tag             String?
  difficulty      String?
  options         Json             @default("[]")

  createdByUid  String @map("created_by_uid")
  createdByName String @default("") @map("created_by_name")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([tag])
  @@map("quiz_question_bank_items")
}

model QuizAttempt {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  quizId   String @map("quiz_id")

  studentUserId    String @map("student_user_id")
  studentName      String @default("") @map("student_name")
  studentRoll      String @default("") @map("student_roll")
  studentBatchName String @default("") @map("student_batch_name")

  attemptNumber Int               @default(1) @map("attempt_number")
  isPractice    Boolean           @default(false) @map("is_practice")
  status        QuizAttemptStatus @default(IN_PROGRESS)

  // Locked-in shuffled order of question ids, computed once at start so a
  // refresh mid-attempt stays stable — same idea as TypingExam's fixed examText.
  questionOrder Json @default("[]") @map("question_order")

  score      Float    @default(0)
  totalMarks Float    @default(0) @map("total_marks")
  percentage Float    @default(0)
  passed     Boolean?

  tabSwitchCount Int @default(0) @map("tab_switch_count")

  // Set when this attempt is a player in a hosted live session.
  liveSessionId String? @map("live_session_id")

  startedAt            DateTime  @default(now()) @map("started_at")
  submittedAt          DateTime? @map("submitted_at")
  durationTakenSeconds Int?      @map("duration_taken_seconds")

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz        Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     QuizAnswer[]
  liveSession QuizLiveSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)

  @@index([liveSessionId])
  @@index([quizId])
  @@index([studentUserId])
  @@index([courseId])
  @@index([status])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String @id @default(uuid())
  courseId   String @map("course_id")
  attemptId  String @map("attempt_id")
  questionId String @map("question_id")

  selectedOptionIds Json     @default("[]") @map("selected_option_ids")
  shortAnswerText   String?  @map("short_answer_text")
  isCorrect         Boolean? @map("is_correct")
  marksAwarded      Float    @default(0) @map("marks_awarded")

  answeredAt DateTime @default(now()) @map("answered_at")
  responseMs Int?     @map("response_ms") // live mode: time taken to answer

  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([courseId])
  @@map("quiz_answers")
}

// A teacher/admin-hosted live run of a quiz (Kahoot style). Students join with
// the code from their logged-in portal. State advances only through host
// actions; the question deadline is computed from questionStartedAt.
model QuizLiveSession {
  id       String @id @default(uuid())
  courseId String @map("course_id")
  quizId   String @map("quiz_id")

  joinCode String         @map("join_code")
  status   QuizLiveStatus @default(LOBBY)

  // Question ids in play order, locked at creation.
  questionOrder          Json      @default("[]") @map("question_order")
  currentIndex           Int       @default(-1) @map("current_index")
  questionStartedAt      DateTime? @map("question_started_at")
  defaultQuestionSeconds Int       @default(20) @map("default_question_seconds")

  hostUid  String @map("host_uid")
  hostName String @default("") @map("host_name")

  createdAt DateTime  @default(now()) @map("created_at")
  endedAt   DateTime? @map("ended_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quiz     Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([courseId])
  @@index([quizId])
  @@index([joinCode])
  @@map("quiz_live_sessions")
}

// ============================================================
// PLATFORM (GLOBAL) SETTINGS
// ============================================================
// A single row, not scoped to any course — the institute's own logo and
// favicon, used on the bare-domain course directory and as the fallback for
// any course that hasn't uploaded its own. Editable only from Super Admin.

model PlatformSettings {
  id         String   @id @default("global")
  logoUrl    String?  @map("logo_url")
  faviconUrl String?  @map("favicon_url")
  updatedAt  DateTime @updatedAt @map("updated_at")
  updatedBy  String?  @map("updated_by")

  @@map("platform_settings")
}

// ============================================================
// TEACHER CLASS ATTENDANCE
// ============================================================
//
// What a teacher actually taught: batch, date, subject, topic and the clock
// time of the class. Separate from AttendanceSession (the student roll call):
// that one is one-per-batch-per-day, this one is one row per class a teacher
// took, so two teachers can each log their own class in the same batch.

// A subject an admin has set up for teachers to pick from (e.g. "Career
// Planning & Branding"). Which teachers may pick it is the assignment table.
model TeachingSubject {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course      Course                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments TeachingSubjectAssignment[]
  logs        TeacherClassLog[]

  @@unique([courseId, name])
  @@index([courseId])
  @@map("teaching_subjects")
}

// teacherUid is User.id — unique per course since accounts became per-course.
model TeachingSubjectAssignment {
  id         String   @id @default(uuid())
  courseId   String   @map("course_id")
  subjectId  String   @map("subject_id")
  teacherUid String   @map("teacher_uid")
  createdAt  DateTime @default(now()) @map("created_at")

  subject TeachingSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherUid])
  @@index([courseId])
  @@index([teacherUid])
  @@map("teaching_subject_assignments")
}

model TeacherClassLog {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")
  // The teacher the class belongs to (User.id) and their name as it was then.
  teacherUid     String   @map("teacher_uid")
  teacherName    String   @map("teacher_name")
  batchId        String   @map("batch_id")
  batchName      String   @map("batch_name")
  subjectId      String?  @map("subject_id")
  // Snapshot, so renaming or deleting a subject later does not rewrite history.
  subjectName    String   @map("subject_name")
  // "YYYY-MM-DD", the same convention classes and schedules use.
  date           String
  topic          String
  // "HH:mm" 24-hour wall-clock (Asia/Dhaka) as entered.
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  durationMin    Int      @map("duration_min")
  // Who pressed Save; differs from teacherUid when an admin filled it in.
  enteredByUid   String   @map("entered_by_uid")
  enteredByName  String   @map("entered_by_name")
  enteredByAdmin Boolean  @default(false) @map("entered_by_admin")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  course  Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch   Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject TeachingSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([courseId, teacherUid, date])
  @@index([courseId, date])
  @@map("teacher_class_logs")
}

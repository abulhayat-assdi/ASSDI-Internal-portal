  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([date])
  @@index([courseId])
  @@map("visitor_logs")

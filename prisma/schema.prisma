// ============================================================
// ASM Internal Portal - PostgreSQL Schema
// Replaces: Firebase Firestore + Firebase Auth
// ============================================================

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  super_admin
  admin
  teacher
  student
}

enum ClassStatus {
  PENDING
  REQUEST_TO_COMPLETE
  COMPLETED
  UPCOMING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ScheduleStatus {
  Scheduled
  Completed
  Upcoming
  Pending
  Today
  Requested
}

enum BatchType {
  Running
  Completed
}

enum BatchStatus {
  active
  archived
}

enum CourseStatus {
  Running
  Completed
  Incomplete
  Expelled
}

enum CurrentlyDoing {
  Job
  Business
  StudyingFurther
  Nothing
}

enum StudentCategory {
  Alim
  General
}

enum FeedbackCategory {
  CourseContent
  Teacher
  Facilities
  Administration
  Other
}

enum MessageStatus {
  unread
  read
  resolved
}

enum PostStatus {
  draft
  published
}

enum ResourceType {
  Presentation
  Notes
  Assignment
  Practice
  Other
}

enum ActorRole {
  ADMIN
  TEACHER
  STUDENT
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum TypingExamAccessType {
  INTERNAL
  PUBLIC
}

enum TypingExamTextSource {
  CUSTOM
  BANK
}

enum TypingExamTakerType {
  STUDENT
  PUBLIC
}

enum TypingExamResult {
  PASS
  AVERAGE
  FAIL
}

enum TypingExamFinishReason {
  TIME_UP
  COMPLETED
  ABANDONED
}

enum TypingExamSessionStatus {
  OPEN
  FINALIZED
  DISCARDED
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum QuizOptionLabelStyle {
  LETTERS
  NUMBERS
  ROMAN
}

enum QuizResultReleaseMode {
  IMMEDIATE
  HELD
}

enum QuizLiveStatus {
  LOBBY
  QUESTION
  REVEAL
  FINISHED
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AWAITING_GRADING
  GRADED
}

// ============================================================
// COURSES (Tenants) — one row per course/subdomain
// ============================================================

model Course {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  tagline      String?
  logoUrl      String?      @map("logo_url")
  faviconUrl   String?      @map("favicon_url")
  primaryColor String       @default("#1a56db") @map("primary_color")
  accentColor  String       @default("#f3f4f6") @map("accent_color")
  status       TenantStatus @default(ACTIVE)
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users                    User[]
  teachers                 Teacher[]
  classes                  Class[]
  classSchedules           ClassSchedule[]
  batches                  Batch[]
  batchStudents            BatchStudent[]
  attendanceSessions       AttendanceSession[]
  teachingSubjects         TeachingSubject[]
  teacherClassLogs         TeacherClassLog[]
  attendanceRecords        AttendanceRecord[]
  attendanceCorrections    AttendanceCorrectionRequest[]
  notices                  Notice[]
  studentNotices           StudentNotice[]
  homeworkSubmissions      HomeworkSubmission[]
  homeworkAssignments      HomeworkAssignment[]
  homeworkAssignmentShares HomeworkAssignmentShare[]
  feedback                 Feedback[]
  contactMessages          ContactMessage[]
  chatThreads              ChatThread[]
  chatMessages             ChatMessage[]
  activityLogs             ActivityLog[]
  resources                Resource[]
  moduleFolders            ModuleFolder[]
  moduleResources          ModuleResource[]
  examResults              ExamResult[]
  routines                 Routine[]
  policies                 Policy[]
  cmsContent               CmsContent[]
  cvDrafts                 CvDraft[]
  cvVersions               CvVersion[]
  studentUpdateRequests    StudentUpdateRequest[]
  studentExamBatchRecords  StudentExamBatchRecord[]
  courseModules            CourseModule[]
  batchForms               BatchForm[]
  studentFormSubmissions   StudentFormSubmission[]
  batchClassCounts         BatchClassCount[]
  studentLeaveRequests     StudentLeaveRequest[]
  deployments              Deployment[]
  visitorLogs              VisitorLog[]
  competitionFormTemplates CompetitionFormTemplate[]
  competitions             Competition[]
  competitionSubmissions   CompetitionSubmission[]
  competitionGroups        CompetitionGroup[]
  competitionCorrections   CompetitionCorrectionRequest[]
  competitionProducts      CompetitionProduct[]
  competitionProcurements  CompetitionProcurement[]
  typingExams              TypingExam[]
  typingExamAttempts       TypingExamAttempt[]
  typingExamSessions       TypingExamSession[]
  loginEvents              LoginEvent[]
  quizzes                  Quiz[]
  quizQuestions            QuizQuestion[]
  quizQuestionBankItems    QuizQuestionBankItem[]
  quizAttempts             QuizAttempt[]
  quizAnswers              QuizAnswer[]
  quizLiveSessions         QuizLiveSession[]

  @@index([slug])
  @@index([status])
  @@map("courses")
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id               String    @id @default(uuid())
  courseId         String?   @map("course_id")
  // Unique per course, not platform-wide (see @@unique below): the same person
  // can hold a separate account — own password, role and permissions — in
  // each course they work in. Every login is already scoped to one course by
  // its domain, so the pair is what identifies an account.
  email            String
  passwordHash     String    @map("password_hash")
  displayName      String    @map("display_name")
  role             UserRole  @default(student)
  teacherId        String?   @map("teacher_id")
  studentBatchName String?   @map("student_batch_name")
  studentRoll      String?   @map("student_roll")
  profileImageUrl  String?   @map("profile_image_url")
  permissions      Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")
  loginCount       Int       @default(0) @map("login_count")
  deletedAt        DateTime? @map("deleted_at")

  // Hidden, non-deletable per-course admin row auto-created the first time the
  // platform's super_admin logs into that course's own login form with their
  // real credentials — see src/app/api/auth/login/route.ts. Excluded from every
  // user-facing listing (Access Management, Admin Users, SaaS admin lists).
  isSuperAdminShadow Boolean @default(false) @map("is_super_admin_shadow")

  // ── Deployment (Mini-Netlify) fields ──────────────────────
  deploymentLimit    Int     @default(5) @map("deployment_limit")
  isDeploymentFrozen Boolean @default(false) @map("is_deployment_frozen")

  course              Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]
  chatMessages        ChatMessage[]
  cvDrafts            CvDraft[]
  activeSession       ActiveSession?
  deployments         Deployment[]
  loginEvents         LoginEvent[]

  @@unique([courseId, email])
  @@index([email])
  @@index([role])
  @@index([courseId])
  @@index([studentBatchName, studentRoll])
  @@map("users")
}

model ActiveSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("active_sessions")
}

// Insert-only login history — never updated, never purged, so platform
// analytics can chart real login activity over any date range. Distinct
// from ActiveSession (one mutable row per user) and from User.lastLoginAt
// (overwritten every login). email/displayName/role are denormalized so a
// record stays meaningful even after the user row is later deleted.
model LoginEvent {
  id          String   @id @default(uuid())
  courseId    String?  @map("course_id")
  userId      String?  @map("user_id")
  role        UserRole
  email       String
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([courseId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("login_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// TEACHERS
// ============================================================

model Teacher {
  id                  String   @id @default(uuid())
  courseId            String   @map("course_id")
  teacherId           String   @map("teacher_id")
  name                String
  designation         String   @default("")
  about               String   @default("")
  phone               String   @default("")
  email               String   @default("")
  loginEmail          String   @default("") @map("login_email")
  profileImageUrl     String?  @map("profile_image_url")
  imageObjectPosition String?  @default("center") @map("image_object_position")
  isAdmin             Boolean  @default(false) @map("is_admin")
  order               Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, teacherId])
  @@index([teacherId])
  @@index([order])
  @@index([courseId])
  @@map("teachers")
}

// ============================================================
// CLASSES & SCHEDULES
// ============================================================

model Class {
  id             String      @id @default(uuid())
  courseId       String      @map("course_id")
  teacherUid     String      @map("teacher_uid")
  teacherName    String      @map("teacher_name")
  date           String
  startTime      String      @default("") @map("start_time")
  endTime        String      @default("") @map("end_time")
  timeRange      String?     @map("time_range")
  batch          String
  subject        String
  status         ClassStatus @default(PENDING)
  completedByUid String?     @map("completed_by_uid")
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherUid])
  @@index([status])
  @@index([date])
  @@index([batch])
  @@index([courseId])
  @@map("classes")
}

model ClassSchedule {
  id          String         @id @default(uuid())
  courseId    String         @map("course_id")
  teacherId   String         @map("teacher_id")
  teacherName String         @map("teacher_name")
  date        String
  day         String         @default("")
  batch       String
  subject     String
  time        String         @default("")
  status      ScheduleStatus @default(Scheduled)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([date])
  @@index([batch])
  @@index([courseId])
  @@map("class_schedules")
}

// ============================================================
// BATCHES
// ============================================================

model Batch {
  id        String      @id @default(uuid())
  courseId  String      @map("course_id")
  name      String
  status    BatchStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students           BatchStudent[]
  attendanceSessions AttendanceSession[]
  teacherClassLogs   TeacherClassLog[]
  feedback           Feedback[]

  @@unique([courseId, name])
  @@index([status])
  @@index([courseId])
  @@map("batches")
}

model BatchStudent {
  id                   String           @id @default(uuid())
  courseId             String           @map("course_id")
  batchId              String           @map("batch_id")
  batchName            String           @map("batch_name")
  roll                 String
  name                 String
  phone                String           @default("")
  address              String           @default("")
  dob                  String?
  educationalDegree    String?          @map("educational_degree")
  category             StudentCategory?
  bloodGroup           String?          @map("blood_group")
  totalPaidTk          String?          @map("total_paid_tk")
  courseStatus         CourseStatus     @default(Running) @map("course_status")
  currentlyDoing       CurrentlyDoing?  @map("currently_doing")
  companyName          String           @default("") @map("company_name")
  businessName         String           @default("") @map("business_name")
  salary               Float            @default(0)
  photo                String?
  batchType            BatchType        @default(Running) @map("batch_type")
  isPublic             Boolean          @default(true) @map("is_public")
  // A roll may be registered once. An admin flips this on to let the same
  // roll be claimed by a different email; registering consumes it again.
  registrationUnlocked Boolean          @default(false) @map("registration_unlocked")
  // When the course status last moved to a blocking value, for the notice
  // shown to the student and for the admin's own records.
  accessBlockedAt      DateTime?        @map("access_blocked_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  completedAt          DateTime?        @map("completed_at")

  // Extended profile fields (filled via student form)
  email            String?
  nidBirthNo       String? @map("nid_birth_no")
  fatherName       String? @map("father_name")
  motherName       String? @map("mother_name")
  permanentAddress String? @map("permanent_address")
  guardianName     String? @map("guardian_name")
  guardianPhone    String? @map("guardian_phone")
  lastInstitute    String? @map("last_institute")
  latestDegree     String? @map("latest_degree")
  gpaResult        String? @map("gpa_result")
  currentDistrict  String? @map("current_district")
  homeDistrict     String? @map("home_district")
  tShirtSize       String? @map("t_shirt_size")
  courseGoal       String? @map("course_goal")

  course                Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch                 Batch                         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]

  @@unique([courseId, batchName, roll])
  @@index([batchName])
  @@index([batchType])
  @@index([courseStatus])
  @@index([courseId])
  @@map("batch_students")
}

// ============================================================
// ATTENDANCE
// ============================================================

// One roll call: a batch on a date, for one subject/slot. The records hang
// off it, so re-opening a roll call to correct it edits rows in place rather
// than creating a second set for the same class.
model AttendanceSession {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  batchId     String   @map("batch_id")
  batchName   String   @map("batch_name")
  // "YYYY-MM-DD", the same convention classes and schedules use.
  date        String
  // Informational only — which class the roll call was taken in. Attendance
  // is one roll call per batch per day, so this is not part of the key.
  subject     String   @default("")
  takenByUid  String   @map("taken_by_uid")
  takenByName String   @map("taken_by_name")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course      Course                        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch       Batch                         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  records     AttendanceRecord[]
  corrections AttendanceCorrectionRequest[]

  // One roll call per batch per day, whoever takes it: a second save for the
  // same day updates the first instead of double-counting it.
  @@unique([courseId, batchId, date])
  @@index([courseId])
  @@index([batchId])
  @@index([date])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  courseId    String           @map("course_id")
  sessionId   String           @map("session_id")
  studentId   String           @map("student_id")
  roll        String
  studentName String           @map("student_name")
  status      AttendanceStatus @default(PRESENT)
  note        String           @default("")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student BatchStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_records")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// A student asking for one day of their attendance to be changed. Tied to the
// roll call and the student rather than to the record row: re-saving a roll
// call rewrites its records, and a request must survive that.
model AttendanceCorrectionRequest {
  id              String                     @id @default(uuid())
  courseId        String                     @map("course_id")
  sessionId       String                     @map("session_id")
  studentId       String                     @map("student_id")
  // Copied from the roll call so the review list reads without joins and
  // still makes sense if the student is later renamed or moved.
  date            String
  batchName       String                     @map("batch_name")
  roll            String
  studentName     String                     @map("student_name")
  // What the record said when the student applied.
  currentStatus   AttendanceStatus           @map("current_status")
  requestedStatus AttendanceStatus           @map("requested_status")
  reason          String
  status          AttendanceCorrectionStatus @default(PENDING)
  reviewedByUid   String?                    @map("reviewed_by_uid")
  reviewedByName  String?                    @map("reviewed_by_name")
  reviewNote      String?                    @map("review_note")
  reviewedAt      DateTime?                  @map("reviewed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  course  Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student BatchStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_correction_requests")
}

// ============================================================
// NOTICES
// ============================================================

model Notice {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  title         String
  description   String
  date          String
  priority      String   @default("normal")
  createdBy     String?  @map("created_by")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([courseId])
  @@map("notices")
}

model StudentNotice {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  title         String
  description   String
  date          String
  priority      String   @default("normal")
  createdBy     String?  @map("created_by")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([courseId])
  @@map("student_notices")
}

// ============================================================
// HOMEWORK
// ============================================================

model HomeworkSubmission {
  id               String    @id @default(uuid())
  courseId         String    @map("course_id")
  studentUid       String    @map("student_uid")
  studentName      String    @map("student_name")
  studentRoll      String    @map("student_roll")
  studentBatchName String    @map("student_batch_name")
  teacherName      String    @map("teacher_name")
  subject          String
  fileUrl          String?   @map("file_url")
  storagePath      String?   @map("storage_path")
  fileName         String?   @map("file_name")
  files            Json?
  textContent      String?   @map("text_content")
  submissionDate   String    @map("submission_date")
  assignmentId     String?   @map("assignment_id")
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  deletedAt        DateTime? @map("deleted_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentUid])
  @@index([teacherName])
  @@index([studentBatchName])
  @@index([submittedAt])
  @@index([courseId])
  @@map("homework_submissions")
}

model HomeworkAssignment {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  teacherUid   String   @map("teacher_uid")
  teacherName  String   @map("teacher_name")
  title        String
  deadlineDate String   @map("deadline_date")
  batchName    String   @map("batch_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  course Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  shares HomeworkAssignmentShare[]

  @@index([teacherUid])
  @@index([batchName])
  @@index([deadlineDate])
  @@index([courseId])
  @@map("homework_assignments")
}

model HomeworkAssignmentShare {
  id                    String   @id @default(uuid())
  courseId              String   @map("course_id")
  assignmentId          String   @map("assignment_id")
  sharedWithTeacherUid  String   @map("shared_with_teacher_uid")
  sharedWithTeacherName String   @map("shared_with_teacher_name")
  sharedByUid           String   @map("shared_by_uid")
  createdAt             DateTime @default(now()) @map("created_at")

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignment HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, sharedWithTeacherUid])
  @@index([assignmentId])
  @@index([sharedWithTeacherUid])
  @@index([courseId])
  @@map("homework_assignment_shares")
}

// ============================================================
// FEEDBACK
// ============================================================

// Anonymous, course-wise student feedback. Submitted from the student
// portal by a signed-in student — identity is stored (studentUid/Name/Roll)
// but only ever exposed to a genuine super_admin session; every course-scoped
// role (teacher/admin) only ever sees batch + category + message.
model Feedback {
  id          String           @id @default(uuid())
  courseId    String           @map("course_id")
  studentUid  String           @map("student_uid")
  studentName String           @map("student_name")
  studentRoll String           @map("student_roll")
  batchId     String?          @map("batch_id")
  batchName   String           @map("batch_name")
  category    FeedbackCategory @default(Other)
  message     String
  rating      Int              @default(5)
  isRead      Boolean          @default(false) @map("is_read")
  readByUid   String?          @map("read_by_uid")
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch  Batch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([isRead])
  @@index([category])
  @@index([batchId])
  @@index([createdAt])
  @@map("feedback")
}

// ============================================================
// CONTACT & CHAT
// ============================================================

model ContactMessage {
  id               String        @id @default(uuid())
  courseId         String        @map("course_id")
  subject          String
  message          String
  studentUid       String        @map("student_uid")
  studentName      String        @map("student_name")
  studentEmail     String        @map("student_email")
  studentBatchName String        @map("student_batch_name")
  studentRoll      String        @map("student_roll")
  status           MessageStatus @default(unread)
  adminReply       String?       @map("admin_reply")
  date             String
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentUid])
  @@index([status])
  @@index([courseId])
  @@map("contact_messages")
}

model ChatThread {
  id                 String   @id @default(uuid())
  courseId           String   @map("course_id")
  studentUid         String   @unique @map("student_uid")
  studentName        String   @map("student_name")
  studentEmail       String   @map("student_email")
  studentBatchName   String   @map("student_batch_name")
  studentRoll        String   @map("student_roll")
  lastMessageText    String   @default("") @map("last_message_text")
  lastMessageTime    DateTime @default(now()) @map("last_message_time")
  unreadCountAdmin   Int      @default(0) @map("unread_count_admin")
  unreadCountStudent Int      @default(0) @map("unread_count_student")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([lastMessageTime])
  @@index([courseId])
  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  threadId    String   @map("thread_id")
  senderId    String?  @map("sender_id")
  sender      String // 'student' | 'admin'
  text        String   @default("")
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([createdAt])
  @@index([courseId])
  @@map("chat_messages")
}


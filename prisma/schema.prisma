  createdAt   DateTime  @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUid], references: [id], onDelete: SetNull)

  @@index([actorUid])
  @@index([createdAt])
  @@index([actionType])
  @@index([courseId])
  @@map("activity_logs")
}

// ============================================================
// RESOURCES

// ============================================================
// ASM Internal Portal - PostgreSQL Schema
// Replaces: Firebase Firestore + Firebase Auth
// ============================================================

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  super_admin
  admin
  teacher
  student
}

enum ClassStatus {
  PENDING
  REQUEST_TO_COMPLETE
  COMPLETED
  UPCOMING
}

enum ScheduleStatus {
  Scheduled
  Completed
  Upcoming
  Pending
  Today
  Requested
}

enum BatchType {
  Running
  Completed
}

enum BatchStatus {
  active
  archived
}

enum CourseStatus {
  Running
  Completed
  Incomplete
  Expelled
}

enum CurrentlyDoing {
  Job
  Business
  StudyingFurther
  Nothing
}

enum StudentCategory {
  Alim
  General
}

enum FeedbackStatus {
  APPROVED
  PENDING
}

enum MessageStatus {
  unread
  read
  resolved
}

enum PostStatus {
  draft
  published
}

enum LeaveType {
  Casual
  Sick
  WeeklyHoliday
  Other
}

enum ResourceType {
  Presentation
  Notes
  Assignment
  Practice
  Other
}

enum ActorRole {
  ADMIN
  TEACHER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  ARCHIVED
}

enum TypingExamAccessType {
  INTERNAL
  PUBLIC
}

enum TypingExamTextSource {
  CUSTOM
  BANK
}

enum TypingExamTakerType {
  STUDENT
  PUBLIC
}

enum TypingExamResult {
  PASS
  AVERAGE
  FAIL
}

// ============================================================
// COURSES (Tenants) — one row per course/subdomain
// ============================================================

model Course {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  tagline      String?
  logoUrl      String?      @map("logo_url")
  faviconUrl   String?      @map("favicon_url")
  primaryColor String       @default("#1a56db") @map("primary_color")
  accentColor  String       @default("#f3f4f6") @map("accent_color")
  status       TenantStatus @default(ACTIVE)
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users                    User[]
  teachers                 Teacher[]
  classes                  Class[]
  classSchedules           ClassSchedule[]
  batches                  Batch[]
  batchStudents            BatchStudent[]
  notices                  Notice[]
  studentNotices           StudentNotice[]
  homeworkSubmissions      HomeworkSubmission[]
  homeworkAssignments      HomeworkAssignment[]
  feedback                 Feedback[]
  contactMessages          ContactMessage[]
  chatThreads              ChatThread[]
  chatMessages             ChatMessage[]
  activityLogs             ActivityLog[]
  leaves                   Leave[]
  leaveSettings            LeaveSettings[]
  resources                Resource[]
  moduleFolders            ModuleFolder[]
  moduleResources          ModuleResource[]
  posts                    Post[]
  blogComments             BlogComment[]
  examResults              ExamResult[]
  routines                 Routine[]
  policies                 Policy[]
  cmsContent               CmsContent[]
  successStories           SuccessStory[]
  videoTestimonials        VideoTestimonial[]
  cvDrafts                 CvDraft[]
  cvVersions               CvVersion[]
  dailyTrackerReports      DailyTrackerReport[]
  studentUpdateRequests    StudentUpdateRequest[]
  studentExamBatchRecords  StudentExamBatchRecord[]
  courseModules            CourseModule[]
  heroImages               HeroImage[]
  batchForms               BatchForm[]
  studentFormSubmissions   StudentFormSubmission[]
  videoStories             VideoStory[]
  batchClassCounts         BatchClassCount[]
  studentLeaveRequests     StudentLeaveRequest[]
  deployments              Deployment[]
  visitorLogs              VisitorLog[]
  competitionFormTemplates CompetitionFormTemplate[]
  competitions             Competition[]
  competitionSubmissions   CompetitionSubmission[]
  competitionGroups        CompetitionGroup[]
  typingExams              TypingExam[]
  typingExamAttempts       TypingExamAttempt[]

  @@index([slug])
  @@index([status])
  @@map("courses")
}

// ============================================================
// AUTHENTICATION
// ============================================================

model User {
  id                   String    @id @default(uuid())
  courseId             String?   @map("course_id")
  email                String    @unique
  passwordHash         String    @map("password_hash")
  displayName          String    @map("display_name")
  role                 UserRole  @default(student)
  teacherId            String?   @map("teacher_id")
  studentBatchName     String?   @map("student_batch_name")
  studentRoll          String?   @map("student_roll")
  profileImageUrl      String?   @map("profile_image_url")
  permissions          Json      @default("[]")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  lastLoginAt          DateTime? @map("last_login_at")
  deletedAt            DateTime? @map("deleted_at")

  // ── Deployment (Mini-Netlify) fields ──────────────────────
  deploymentLimit      Int       @default(5)    @map("deployment_limit")
  isDeploymentFrozen   Boolean   @default(false) @map("is_deployment_frozen")

  course              Course?               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  activityLogs        ActivityLog[]
  chatMessages        ChatMessage[]
  cvDrafts            CvDraft[]
  activeSession       ActiveSession?
  deployments         Deployment[]

  @@index([email])
  @@index([role])
  @@index([courseId])
  @@index([studentBatchName, studentRoll])
  @@map("users")
}

model ActiveSession {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("active_sessions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// TEACHERS
// ============================================================

model Teacher {
  id                   String   @id @default(uuid())
  courseId             String   @map("course_id")
  teacherId            String   @unique @map("teacher_id")
  name                 String
  designation          String   @default("")
  about                String   @default("")
  phone                String   @default("")
  email                String   @default("")
  loginEmail           String   @default("") @map("login_email")
  profileImageUrl      String?  @map("profile_image_url")
  imageObjectPosition  String?  @default("center") @map("image_object_position")
  isAdmin              Boolean  @default(false) @map("is_admin")
  order                Int      @default(0)
  leaveTrackingEnabled Boolean  @default(false) @map("leave_tracking_enabled")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  leaves       Leave[]
  leaveSettings LeaveSettings?

  @@index([teacherId])
  @@index([order])
  @@index([courseId])
  @@map("teachers")
}

// ============================================================
// CLASSES & SCHEDULES
// ============================================================

model Class {
  id             String      @id @default(uuid())
  courseId       String      @map("course_id")
  teacherUid     String      @map("teacher_uid")
  teacherName    String      @map("teacher_name")
  date           String
  startTime      String      @default("") @map("start_time")
  endTime        String      @default("") @map("end_time")
  timeRange      String?     @map("time_range")
  batch          String
  subject        String
  status         ClassStatus @default(PENDING)
  completedByUid String?     @map("completed_by_uid")
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherUid])
  @@index([status])
  @@index([date])
  @@index([batch])
  @@index([courseId])
  @@map("classes")
}

model ClassSchedule {
  id          String         @id @default(uuid())
  courseId    String         @map("course_id")
  teacherId   String         @map("teacher_id")
  teacherName String         @map("teacher_name")
  date        String
  day         String         @default("")
  batch       String
  subject     String
  time        String         @default("")
  status      ScheduleStatus @default(Scheduled)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([date])
  @@index([batch])
  @@index([courseId])
  @@map("class_schedules")
}

// ============================================================
// BATCHES
// ============================================================

model Batch {
  id        String      @id @default(uuid())
  courseId  String      @map("course_id")
  name      String
  status    BatchStatus @default(active)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students BatchStudent[]

  @@unique([courseId, name])
  @@index([status])
  @@index([courseId])
  @@map("batches")
}

model BatchStudent {
  id                 String          @id @default(uuid())
  courseId           String          @map("course_id")
  batchId            String          @map("batch_id")
  batchName          String          @map("batch_name")
  roll               String
  name               String
  phone              String          @default("")
  address            String          @default("")
  dob                String?
  educationalDegree  String?         @map("educational_degree")
  category           StudentCategory?
  bloodGroup         String?         @map("blood_group")
  totalPaidTk        String?         @map("total_paid_tk")
  courseStatus       CourseStatus    @default(Running) @map("course_status")
  currentlyDoing     CurrentlyDoing? @map("currently_doing")
  companyName        String          @default("") @map("company_name")
  businessName       String          @default("") @map("business_name")
  salary             Float           @default(0)
  photo              String?
  batchType          BatchType       @default(Running) @map("batch_type")
  isPublic           Boolean         @default(true) @map("is_public")
  createdAt          DateTime        @default(now()) @map("created_at")
  completedAt        DateTime?       @map("completed_at")

  // Extended profile fields (filled via student form)
  email              String?
  nidBirthNo         String?         @map("nid_birth_no")
  fatherName         String?         @map("father_name")
  motherName         String?         @map("mother_name")
  permanentAddress   String?         @map("permanent_address")
  guardianName       String?         @map("guardian_name")
  guardianPhone      String?         @map("guardian_phone")
  lastInstitute      String?         @map("last_institute")
  latestDegree       String?         @map("latest_degree")
  gpaResult          String?         @map("gpa_result")
  currentDistrict    String?         @map("current_district")
  homeDistrict       String?         @map("home_district")
  tShirtSize         String?         @map("t_shirt_size")
  courseGoal         String?         @map("course_goal")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch  Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([courseId, batchName, roll])
  @@index([batchName])
  @@index([batchType])
  @@index([courseStatus])
  @@index([courseId])
  @@map("batch_students")
}

// ============================================================
// NOTICES
// ============================================================

model Notice {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  title         String
  description   String
  date          String
  priority      String   @default("normal")
  createdBy     String?  @map("created_by")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([courseId])
  @@map("notices")
}

model StudentNotice {
  id            String   @id @default(uuid())
  courseId      String   @map("course_id")
  title         String
  description   String
  date          String
  priority      String   @default("normal")
  createdBy     String?  @map("created_by")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([courseId])
  @@map("student_notices")
}

// ============================================================
// HOMEWORK
// ============================================================

model HomeworkSubmission {
  id               String   @id @default(uuid())
  courseId         String   @map("course_id")
  studentUid       String   @map("student_uid")
  studentName      String   @map("student_name")
  studentRoll      String   @map("student_roll")
  studentBatchName String   @map("student_batch_name")
  teacherName      String   @map("teacher_name")
  subject          String
  fileUrl          String?  @map("file_url")
  storagePath      String?  @map("storage_path")
  fileName         String?  @map("file_name")
  files            Json?
  textContent      String?  @map("text_content")
  submissionDate   String   @map("submission_date")
  assignmentId     String?  @map("assignment_id")
  submittedAt      DateTime @default(now()) @map("submitted_at")
  deletedAt        DateTime? @map("deleted_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentUid])
  @@index([teacherName])
  @@index([studentBatchName])
  @@index([submittedAt])
  @@index([courseId])
  @@map("homework_submissions")
}

model HomeworkAssignment {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  teacherUid  String   @map("teacher_uid")
  teacherName String   @map("teacher_name")
  title       String
  deadlineDate String  @map("deadline_date")
  batchName   String   @map("batch_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([teacherUid])
  @@index([batchName])
  @@index([deadlineDate])
  @@index([courseId])
  @@map("homework_assignments")
}

// ============================================================
// FEEDBACK
// ============================================================

model Feedback {
  id            String         @id @default(uuid())
  courseId      String         @map("course_id")
  studentName   String         @map("student_name")
  batch         String
  role          String         @default("")
  company       String         @default("")
  message       String
  rating        Int            @default(5)
  status        FeedbackStatus @default(PENDING)
  submittedFrom String         @default("PUBLIC_FORM") @map("submitted_from")
  approvedByUid String?        @map("approved_by_uid")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([courseId])
  @@map("feedback")
}

// ============================================================
// CONTACT & CHAT
// ============================================================

model ContactMessage {
  id               String        @id @default(uuid())
  courseId         String        @map("course_id")
  subject          String
  message          String
  studentUid       String        @map("student_uid")
  studentName      String        @map("student_name")
  studentEmail     String        @map("student_email")
  studentBatchName String        @map("student_batch_name")
  studentRoll      String        @map("student_roll")
  status           MessageStatus @default(unread)
  adminReply       String?       @map("admin_reply")
  date             String
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([studentUid])
  @@index([status])
  @@index([courseId])
  @@map("contact_messages")
}

model ChatThread {
  id               String    @id @default(uuid())
  courseId         String    @map("course_id")
  studentUid       String    @unique @map("student_uid")
  studentName      String    @map("student_name")
  studentEmail     String    @map("student_email")
  studentBatchName String    @map("student_batch_name")
  studentRoll      String    @map("student_roll")
  lastMessageText  String    @default("") @map("last_message_text")
  lastMessageTime  DateTime  @default(now()) @map("last_message_time")
  unreadCountAdmin Int       @default(0) @map("unread_count_admin")
  unreadCountStudent Int     @default(0) @map("unread_count_student")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([lastMessageTime])
  @@index([courseId])
  @@map("chat_threads")
}

model ChatMessage {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  threadId    String   @map("thread_id")
  senderId    String?  @map("sender_id")
  sender      String   // 'student' | 'admin'
  text        String   @default("")
  attachments Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")

  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([threadId])
  @@index([createdAt])
  @@index([courseId])
  @@map("chat_messages")
}

// ============================================================
// ACTIVITY LOGS
// ============================================================

model ActivityLog {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  actorUid    String    @map("actor_uid")
  actorRole   ActorRole @map("actor_role")
  actionType  String    @map("action_type")
  targetType  String    @map("target_type")
  targetId    String    @map("target_id")
  description String
  createdAt   DateTime  @default(now()) @map("created_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUid], references: [id], onDelete: SetNull)

  @@index([actorUid])
  @@index([createdAt])
  @@index([actionType])
  @@index([courseId])
  @@map("activity_logs")
}

// ============================================================
// LEAVES
// ============================================================

model Leave {
  id          String    @id @default(uuid())
  courseId    String    @map("course_id")
  teacherId   String    @map("teacher_id")
  teacherName String    @map("teacher_name")
  startDate   String    @map("start_date")
  endDate     String    @map("end_date")
  days        Int       @default(1)
  type        LeaveType @default(Casual)
  reason      String?
  monthYear   String    @map("month_year")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [teacherId], onDelete: Cascade)

  @@index([teacherId])
  @@index([monthYear])
  @@index([type])
  @@index([courseId])
  @@map("leaves")
}

model LeaveSettings {
  id                   String   @id @default(uuid())
  courseId             String   @map("course_id")
  teacherId            String   @unique @map("teacher_id")
  teacherName          String   @map("teacher_name")
  weeklyHolidays       Json     @default("[]") @map("weekly_holidays")
  joinDate             String   @map("join_date")
  lastAutoGeneratedDate String? @map("last_auto_generated_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [teacherId], onDelete: Cascade)

  @@index([courseId])
  @@map("leave_settings")
}

// ============================================================
// RESOURCES
// ============================================================

model Resource {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  fileType    String   @map("file_type")
  fileName    String   @map("file_name")
  fileUrl     String   @map("file_url")
  storagePath String   @map("storage_path")
  fileSize    String?  @map("file_size")
  uploadedBy  String?  @map("uploaded_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([courseId])
  @@map("resources")
}

model ModuleFolder {
  id                String        @id @default(uuid())
  courseId          String        @map("course_id")
  teacherUid        String        @default("") @map("teacher_uid")
  teacherName       String        @default("") @map("teacher_name")
  parentFolderId    String?       @map("parent_folder_id")
  title             String        @default("")
  description       String?
  visibleForBatches Json          @default("[\"all\"]") @map("visible_for_batches")
  isHidden          Boolean       @default(false) @map("is_hidden")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parentFolder ModuleFolder?  @relation("SubFolders", fields: [parentFolderId], references: [id], onDelete: Cascade)
  subFolders   ModuleFolder[] @relation("SubFolders")
  resources    ModuleResource[]

  @@index([teacherUid])
  @@index([parentFolderId])
  @@index([courseId])
  @@map("module_folders")
}

model ModuleResource {
  id                 String       @id @default(uuid())
  courseId           String       @map("course_id")
  moduleId           String       @default("") @map("module_id")
  moduleTitle        String       @default("") @map("module_title")
  teacherName        String       @default("") @map("teacher_name")
  teacherUid         String       @default("") @map("teacher_uid")
  folderId           String?      @map("folder_id")
  title              String
  description        String?
  fileType           String       @map("file_type")
  fileName           String       @map("file_name")
  fileUrl            String       @map("file_url")
  storagePath        String       @map("storage_path")
  fileSize           String?      @map("file_size")
  resourceType       ResourceType @default(Other) @map("resource_type")
  visibleForBatches  Json         @default("[\"all\"]") @map("visible_for_batches")
  isHidden           Boolean      @default(false) @map("is_hidden")
  uploadedAt         DateTime     @default(now()) @map("uploaded_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  course Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  folder ModuleFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([moduleTitle])
  @@index([teacherUid])
  @@index([folderId])
  @@index([courseId])
  @@map("module_resources")
}

// ============================================================
// BLOG
// ============================================================

model Post {
  id              String     @id @default(uuid())
  courseId        String     @map("course_id")
  title           String
  slug            String
  excerpt         String     @default("")
  featuredImage   String?    @map("featured_image")
  content         String
  category        String?
  metaTitle       String?    @map("meta_title")
  metaDescription String?    @map("meta_description")
  keywords        String?
  status          PostStatus @default(draft)
  publishedAt     DateTime?  @map("published_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  comments BlogComment[]

  @@unique([courseId, slug])
  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@index([courseId])

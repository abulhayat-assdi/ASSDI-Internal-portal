# ============================================================
# ASM Portal V2 — Production env template (VPS Docker Compose)
# Copy: cp .env.example .env  → fill secrets → chmod 600 .env
# NEVER commit .env (gitignored). Generate secrets with:
#   openssl rand -base64 48  (JWT_SECRET, 32+ chars min)
#   openssl rand -base64 24  (PGRST_AUTHENTICATOR_PASSWORD, SETUP_SECRET)
# ============================================================

# --- Database (compose internal; all REQUIRED, no fallbacks) ---
# DB_USER is the Postgres superuser the image creates. It is used ONLY for
# migrations and schema patches at boot.
DB_USER=asm_super
DB_PASSWORD=CHANGE_ME_strong_random
DB_NAME=asm_portal

# The unprivileged role the running app queries as. This is what makes
# row-level security real: a superuser connection bypasses RLS entirely, so
# with only DB_USER the course-isolation policies do nothing.
# scripts/ensure-app-role.js creates/updates this role on every boot.
APP_DB_USER=asm_app
APP_DB_PASSWORD=CHANGE_ME_different_strong_random

# App container builds this from above; override only for external DB
# DATABASE_URL=postgresql://asm_app:CHANGE_ME@db:5432/asm_portal?schema=public

# Prisma pool size for the app's own DATABASE_URL (docker-entrypoint.sh
# appends these) and the matching Postgres-side ceiling. Keep
# POSTGRES_MAX_CONNECTIONS comfortably above DB_POOL_SIZE + PGRST_DB_POOL
# (docker-compose.yml) + a few spare connections for psql/migrations.
# DB_POOL_SIZE=15
# DB_POOL_TIMEOUT=20
# POSTGRES_MAX_CONNECTIONS=100
# POSTGRES_SHARED_BUFFERS=256MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAINTENANCE_WORK_MEM=64MB

# --- Auth (REQUIRED, min 32 chars) ---
JWT_SECRET=CHANGE_ME_min_32_chars_random
# JWT_EXPIRES_IN=30d

# How long a session's role/permissions/revocation check is cached in memory
# before re-querying the DB (see src/lib/auth.ts). Raise for less DB load
# under heavy traffic; lower (or set to 0 to disable) for faster propagation
# of role changes and "kick out" — most such edits already invalidate the
# affected user's entry immediately, so this mainly bounds the rest.
# AUTH_OVERRIDE_CACHE_MS=10000

# --- One-time super-admin bootstrap ---
# All three are required by POST /api/setup. Send the secret as the
# x-setup-secret header (never in the query string), then UNSET SETUP_SECRET
# and redeploy:
#   curl -X POST https://admin.<domain>/api/setup -H "x-setup-secret: $SETUP_SECRET"
SETUP_SECRET=CHANGE_ME_one_time_bootstrap_only
SUPER_ADMIN_EMAIL=admin@tasm-skill.asf.bd
SUPER_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
# SUPER_ADMIN_NAME="Super Admin"
# Account that can never be stripped of admin from inside the app.
# NEXT_PUBLIC_PORTAL_OWNER_EMAIL=owner@tasm-skill.asf.bd

# --- Typing-game PostgREST bridge (REQUIRED, must match 0039_auth_shim.sql) ---
PGRST_AUTHENTICATOR_PASSWORD=CHANGE_ME_random
# POSTGREST_URL is wired internally (http://postgrest:3000); don't override in compose

# --- Domain / URLs (REQUIRED for SaaS subdomains + auth cookies) ---
NEXT_PUBLIC_BASE_DOMAIN=tasm-skill.asf.bd
NEXT_PUBLIC_APP_URL=https://tasm-skill.asf.bd
# APP_URL=https://tasm-skill.asf.bd

# --- SMTP (REQUIRED for password-reset; else auth recovery dead) ---
SMTP_HOST=mail.tasm-skill.asf.bd
SMTP_PORT=587
SMTP_USER=noreply@tasm-skill.asf.bd
SMTP_PASS=CHANGE_ME
SMTP_FROM="ASM Portal <noreply@tasm-skill.asf.bd>"

# --- SaaS owner (super-admin bootstrap alerts) ---
SAAS_OWNER_EMAIL=admin@tasm-skill.asf.bd

# --- Optional ---
# Per-account upload quota in MB (default 500).
# USER_STORAGE_QUOTA_MB=500
# Number of reverse proxies in front of the app; rate limiting reads the
# client IP this many hops from the right of X-Forwarded-For (default 1).
# TRUSTED_PROXY_HOPS=1

# Password hashing cost (bcrypt). Default 10. Every login pays this on the
# CPU: cost 12 measured at 331ms per verification on a 2-core host, capping
# logins at ~6/second; cost 10 is ~83ms. Raise it on a machine with CPU to
# spare — existing hashes upgrade themselves at each user's next sign-in.
# BCRYPT_COST=10

# --- Rate limits (all optional; raise them for large shared networks) ---
# Every value below is a maximum per window, per IP unless noted. Defaults are
# already sized for a campus where hundreds of students share one address.
# Login is counted over FAILED attempts only, so a busy classroom signing in
# normally never approaches the cap.
# RATE_LIMIT_LOGIN_EMAIL=20     # failed logins per account / 15 min
# RATE_LIMIT_LOGIN_IP=200       # failed logins per IP / 15 min
# RATE_LIMIT_REGISTER=50        # self-registrations per IP / hour
# RATE_LIMIT_RESET_IP=30        # password-reset requests per IP / hour
# RATE_LIMIT_RESET_EMAIL=5      # password-reset requests per mailbox / hour
# RATE_LIMIT_RESET_CONFIRM=60   # reset-token submissions per IP / 15 min
# RATE_LIMIT_FEEDBACK=60        # feedback submissions per IP / hour
# RATE_LIMIT_FORM_READ=300      # student-form loads per IP / hour
# RATE_LIMIT_FORM_SUBMIT=100    # student-form submissions per IP / hour
# RATE_LIMIT_EXAM_CHECK=300     # typing-exam identity checks per IP / hour
# RATE_LIMIT_EXAM_ATTEMPT=300   # typing-exam submissions per IP / hour
# RATE_LIMIT_CHAT=30            # AI chat messages per IP / minute
# GEMINI_API_KEY=
# NEXT_PUBLIC_AD_PROVIDER=
# MAX_DEPLOY_SIZE_MB=50
# LOCAL_STORAGE_PATH=/app/storage  (set in compose; don't override)

# vitest@5 wants @types/node ^22||>=24 as peerOptional while the project
# pins @types/node@^20 — npm 10 (node:20-alpine, used in Docker) treats this
# as a hard ERESOLVE error during `npm ci` and the Coolify build fails.
# legacy-peer-deps keeps installs deterministic from package-lock.json.
legacy-peer-deps=true
